# Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@host.docker.internal:5432/e_commerce?sslmode=disable

# Stripe
STRIPE_API_KEY=sk_test_REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# Clerk
CLERK_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_CLERK_SECRET_KEY
CLERK_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_CLERK_WEBHOOK_SECRET
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_REPLACE_WITH_YOUR_CLERK_PUBLISHABLE_KEY

# Medusa
MEDUSA_API_KEY=sk_REPLACE_WITH_YOUR_MEDUSA_API_KEY
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_REPLACE_WITH_YOUR_MEDUSA_PUBLISHABLE_KEY
PORTAL_REGION_ID=reg_REPLACE_ME
PORTAL_SALES_CHANNEL_ID=sc_REPLACE_ME
