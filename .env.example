# Database
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@host.docker.internal:5432/e_commerce?sslmode=disable

# Stripe
STRIPE_API_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME

# Clerk
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_WEBHOOK_SECRET=whsec_REPLACE_ME

# Medusa
MEDUSA_API_KEY=sk_REPLACE_ME
PORTAL_REGION_ID=reg_REPLACE_ME
PORTAL_SALES_CHANNEL_ID=sc_REPLACE_ME
