    "headless",
    "medusa"
  ],
  "scripts": {
    "patch:dashboard": "node scripts/patch-medusa-dashboard-create-additional-data.js",
    "postinstall": "node -e \"const fs=require('fs'); const p='scripts/patch-medusa-dashboard-create-additional-data.js'; if (fs.existsSync(p)) require('./'+p); else console.log('[patch-medusa-dashboard] patch script not present, skipping')\"",
    "prebuild": "npm run patch:dashboard",
    "build": "medusa build",
    "predev": "npm run patch:dashboard",
    "start": "medusa start",
    "dev": "medusa develop"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.14.1",
    "@medusajs/admin-shared": "2.14.1",
    "@medusajs/caching": "2.14.1",
    "@medusajs/cli": "2.14.1",
    "@medusajs/dashboard": "2.14.1",
    "@medusajs/draft-order": "2.14.1",
    "@medusajs/framework": "2.14.1",
    "@medusajs/medusa": "2.14.1",
    "@medusajs/ui": "4.1.8",
    "@tanstack/react-query": "5.64.2",
    "bcryptjs": "^3.0.3",
    "googleapis": "^171.4.0",
    "nodemailer": "^8.0.7",
    "react-i18next": "13.5.0",
    "react-router-dom": "6.30.3",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@swc/core": "^1.7.28",
